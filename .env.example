# .env.example - Plantilla de variables de entorno para NetTrack CMDB & ITAM
# Copia este archivo como ".env" en este mismo directorio y ajusta los valores.

# Configuración de Seguridad
SECRET_KEY=supersecretkeyfornettrackcmdbsecurity2026
SUPERADMIN_USER=admin
SUPERADMIN_PASSWORD=adminpassword

# Configuración de Base de Datos (Opcional - por defecto usa postgres)
POSTGRES_PASSWORD=postgres
